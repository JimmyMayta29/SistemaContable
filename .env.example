NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://usuario:contraseña@127.0.0.1:5432/control_estudio
# Generar dos secretos distintos de al menos 32 caracteres.
JWT_SECRET=
JWT_REFRESH_SECRET=
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SUNAT_ENCRYPTION_KEY=
# Para servidores remotos usar sslmode=verify-full y un certificado confiable.
